# AutoRFx backend settings. Copy to .env; never commit .env.
# Every value is optional: with no key the pipeline runs rule-based ("rule-only") end to end.

# LLM (optional). Empty or the placeholder below means "not connected".
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Which clauses the LLM confirms when a key is set: always | ambiguous_only | never
AUTORFX_CONFIRM_POLICY=ambiguous_only
AUTORFX_LLM_CONCURRENCY=4

# Dedicated translation API (not implemented yet; reserved)
DEEPL_API_KEY=your_deepl_api_key_here

# Embedding model for dense retrieval. Empty = keyword search (BM25) only.
#   BAAI/bge-m3                    local, multilingual (KO/EN/DE). First: uv sync --extra embedding
#   openai:text-embedding-3-small  uses OPENAI_API_KEY
# When set, chat search becomes hybrid (BM25 + embedding, reciprocal rank fusion).
EMBEDDING_MODEL=
# Cosine similarity a sentence needs to count as evidence. Calibrate with `autorfx compare-search`.
EMBEDDING_MIN_SCORE=0.55

# Data folder: rules/ (committed), raw/dev/ (development RFQs), work/, cache/, answer_keys/ (all local)
AUTORFX_DATA_DIR=data

# API server
AUTORFX_CORS_ORIGINS=http://localhost:3000,http://localhost:3200
AUTORFX_MAX_FILES=30
AUTORFX_MAX_FILE_MB=50

# Optional: path to a Chromium binary for converting .doc on macOS when LibreOffice is absent
# AUTORFX_CHROMIUM=
