# AutoRFx backend settings. Copy to .env; never commit .env.
# Every value is optional: with no key the pipeline runs rule-based ("rule-only") end to end.

# LLM (optional). Empty or the placeholder below means "not connected".
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Chat answers: how long a reasoning model (gpt-5*, o*) thinks: low (default) | medium | high. Empty = not sent.
# OPENAI_CHAT_EFFORT=low

# Translation model and its reasoning effort, set as a pair. Blank model = same as OPENAI_MODEL.
# gpt-6-luna needs effort none, or it thinks at medium and bills that as output tokens.
# Leave effort blank for gpt-4o (it does not accept the parameter). none | low | medium | high
# An effort without a model, or with a gpt-4* model, is refused at start.
# With a key, <data dir>/translation/prices.yaml must exist (USD per 1M tokens), or the server does not start:
# copy it along with rules/ when AUTORFX_DATA_DIR points elsewhere. An effort change alone keeps cached translations.
OPENAI_TRANSLATION_MODEL=
OPENAI_TRANSLATION_EFFORT=

# Which clauses the LLM confirms when a key is set: always | ambiguous_only | never
AUTORFX_CONFIRM_POLICY=ambiguous_only
AUTORFX_LLM_CONCURRENCY=4

# Dedicated translation API (not implemented yet; reserved)
DEEPL_API_KEY=your_deepl_api_key_here

# Embedding model for dense retrieval (chat search is hybrid: BM25 + embedding, reciprocal rank fusion).
#   openai:text-embedding-3-large  default; uses OPENAI_API_KEY (without a key: keyword search only)
#   BAAI/bge-m3                    local, multilingual. First: uv sync --extra embedding
# An empty value turns the embedding search off (keyword search only).
EMBEDDING_MODEL=openai:text-embedding-3-large
# Cosine similarity a sentence needs to count as evidence. Leave it out to use the value measured for the
# model (3-large 0.30, BGE-M3 0.55); set it only after measuring with `autorfx score-search`.
# EMBEDDING_MIN_SCORE=0.30

# Data folder: rules/ (committed), raw/dev/ (development RFQs), work/, cache/, answer_keys/ (all local)
AUTORFX_DATA_DIR=data

# API server
AUTORFX_CORS_ORIGINS=http://localhost:3000,http://localhost:3200
AUTORFX_MAX_FILES=30
AUTORFX_MAX_FILE_MB=50

# Optional: path to a Chromium binary for converting .doc on macOS when LibreOffice is absent
# AUTORFX_CHROMIUM=
