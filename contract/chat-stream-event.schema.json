{
  "$id": "https://autorfx.local/contract/chat-stream-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "stage"
        },
        "stage": {
          "type": "string",
          "enum": [
            "plan",
            "search",
            "write",
            "verify",
            "rewrite"
          ]
        },
        "evidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "stage"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "progress"
        },
        "drafted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "drafted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "done"
        },
        "response": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "answered",
                    "no_evidence",
                    "restricted",
                    "guide"
                  ]
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "extractive",
                    "generative",
                    "stored"
                  ]
                },
                "answer": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "finding": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "summary",
                                "priority",
                                "red_flag",
                                "answer",
                                "cost_input",
                                "consistency"
                              ]
                            },
                            "departments": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "text": {
                              "type": "string"
                            },
                            "priority": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "must",
                                    "should",
                                    "optional",
                                    "info"
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "red_flag_reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "citations": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "source_doc": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "page_number": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991
                                  },
                                  "section_id": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "paragraph_index": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991
                                  },
                                  "sentence_index": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991
                                  },
                                  "anchor": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  }
                                },
                                "required": [
                                  "source_doc",
                                  "page_number",
                                  "section_id",
                                  "paragraph_index",
                                  "sentence_index",
                                  "anchor"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "departments",
                            "text",
                            "priority",
                            "red_flag_reason",
                            "citations"
                          ],
                          "additionalProperties": false
                        },
                        "citation_status": {
                          "type": "string",
                          "enum": [
                            "verified",
                            "unverified"
                          ]
                        },
                        "failed_citations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "source_doc": {
                                "type": "string",
                                "minLength": 1
                              },
                              "page_number": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "section_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "paragraph_index": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "sentence_index": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "anchor": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "source_doc",
                              "page_number",
                              "section_id",
                              "paragraph_index",
                              "sentence_index",
                              "anchor"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "finding",
                        "citation_status",
                        "failed_citations"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "statements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "citations": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source_doc": {
                              "type": "string",
                              "minLength": 1
                            },
                            "page_number": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "section_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "paragraph_index": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "sentence_index": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "anchor": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "source_doc",
                            "page_number",
                            "section_id",
                            "paragraph_index",
                            "sentence_index",
                            "anchor"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "text",
                      "citations"
                    ],
                    "additionalProperties": false
                  }
                },
                "conflicts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "citations": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source_doc": {
                              "type": "string",
                              "minLength": 1
                            },
                            "page_number": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "section_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "paragraph_index": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "sentence_index": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "anchor": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "source_doc",
                            "page_number",
                            "section_id",
                            "paragraph_index",
                            "sentence_index",
                            "anchor"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "title",
                      "detail",
                      "citations"
                    ],
                    "additionalProperties": false
                  }
                },
                "message": {
                  "type": "string"
                },
                "suggestions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "status",
                "mode",
                "answer",
                "statements",
                "conflicts",
                "message",
                "suggestions"
              ],
              "additionalProperties": false
            },
            "provenance": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "document",
                  "parsing",
                  "analysis",
                  "citation",
                  "translation",
                  "source",
                  "consistency",
                  "cost_inputs",
                  "precost",
                  "chat",
                  "evaluation"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "mock",
                  "real"
                ]
              }
            }
          },
          "required": [
            "data",
            "provenance"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "response"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
