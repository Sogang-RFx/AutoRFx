{
  "$id": "https://autorfx.local/contract/meta.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "departments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "receives_all": {
                "type": "boolean"
              },
              "cost_visible": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "role",
              "receives_all",
              "cost_visible"
            ],
            "additionalProperties": false
          }
        },
        "assumption_note": {
          "type": "string"
        },
        "engines": {
          "type": "object",
          "properties": {
            "analysis": {
              "type": "string",
              "minLength": 1
            },
            "translation": {
              "type": "string",
              "minLength": 1
            },
            "retrieval": {
              "type": "string",
              "minLength": 1
            },
            "llm_connected": {
              "type": "boolean"
            }
          },
          "required": [
            "analysis",
            "translation",
            "retrieval",
            "llm_connected"
          ],
          "additionalProperties": false
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "file_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "label",
              "file_count"
            ],
            "additionalProperties": false
          }
        },
        "upload": {
          "type": "object",
          "properties": {
            "max_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_file_mb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "accept": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "max_files",
            "max_file_mb",
            "accept"
          ],
          "additionalProperties": false
        },
        "voice": {
          "type": "object",
          "properties": {
            "transcribe": {
              "type": "boolean"
            },
            "speak": {
              "type": "boolean"
            },
            "max_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_speech_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "transcribe",
            "speak",
            "max_seconds",
            "max_speech_chars"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "departments",
        "assumption_note",
        "engines",
        "samples",
        "upload",
        "voice"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "consistency",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
