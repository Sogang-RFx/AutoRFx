{
  "$id": "https://autorfx.local/contract/job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "boolean"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "part": {
                "type": "string",
                "enum": [
                  "document",
                  "parsing",
                  "analysis",
                  "citation",
                  "translation",
                  "source",
                  "consistency",
                  "cost_inputs",
                  "precost",
                  "chat",
                  "evaluation"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "done",
                  "error",
                  "skipped"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "detail",
              "part",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "started_at",
        "done",
        "stages"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "consistency",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
