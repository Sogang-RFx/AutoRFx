{
  "$id": "https://autorfx.local/contract/document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "files": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "pdf",
                  "doc",
                  "docx",
                  "xlsx"
                ]
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "de",
                  "ko",
                  "mixed",
                  "unknown"
                ]
              },
              "page_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "canonical_tool": {
                "type": "string",
                "minLength": 1
              },
              "canonical_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "clause_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "lang",
              "page_count",
              "sha256",
              "canonical_tool",
              "canonical_sha256",
              "clause_count",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "is_sample": {
          "type": "boolean"
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "files",
        "page_count",
        "sha256",
        "is_sample",
        "notice"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "consistency",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
