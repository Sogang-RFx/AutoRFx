{
  "$id": "https://autorfx.local/contract/sheet-suggest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "header_row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 39
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "no",
              "part",
              "description",
              "spec",
              "quantity",
              "unit",
              "months",
              "price",
              "total"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "reason": {
          "type": "string"
        },
        "lines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "preview": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "engine": {
          "type": "string"
        }
      },
      "required": [
        "header_row",
        "columns",
        "reason",
        "lines",
        "preview",
        "rows",
        "engine"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "consistency",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
