{
  "$id": "https://autorfx.local/contract/password-change-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "current_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "new_password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  },
  "required": [
    "current_password",
    "new_password"
  ],
  "additionalProperties": false
}
