{
  "$id": "https://autorfx.local/contract/sheet-words.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "no",
                  "part",
                  "description",
                  "spec",
                  "quantity",
                  "unit",
                  "months",
                  "price",
                  "total"
                ]
              },
              "text": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "last_seen": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "text",
              "count",
              "last_seen"
            ],
            "additionalProperties": false
          }
        },
        "approved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "no",
                  "part",
                  "description",
                  "spec",
                  "quantity",
                  "unit",
                  "months",
                  "price",
                  "total"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "candidates",
        "approved"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "consistency",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
