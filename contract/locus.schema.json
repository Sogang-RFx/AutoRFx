    "page_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "section_id": {
      "type": "string",
      "minLength": 1
    },
    "paragraph_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sentence_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
