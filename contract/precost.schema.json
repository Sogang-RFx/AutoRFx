{
  "$id": "https://autorfx.local/contract/precost.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "minLength": 1
            },
            "min_quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "fixed_costs": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "variable_cost_per_unit": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "target_price": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "item",
            "min_quantity",
            "fixed_costs",
            "variable_cost_per_unit",
            "currency",
            "target_price"
          ],
          "additionalProperties": false
        },
        "breakdown": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d+)?$"
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "piece_cost": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?$"
                },
                "piece_price": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?$"
                }
              },
              "required": [
                "lines",
                "piece_cost",
                "piece_price"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed_cost_per_unit": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "unit_cost": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "issue_id": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "issue_id",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "unit_cost": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              }
            },
            "required": [
              "label",
              "choices",
              "unit_cost"
            ],
            "additionalProperties": false
          }
        },
        "range": {
          "type": "object",
          "properties": {
            "low": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "high": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            }
          },
          "required": [
            "low",
            "high"
          ],
          "additionalProperties": false
        },
        "yearly": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "price": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              "below_cost": {
                "type": "boolean"
              }
            },
            "required": [
              "year",
              "price",
              "below_cost"
            ],
            "additionalProperties": false
          }
        },
        "decision": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "go",
                "no_go",
                "hold",
                "baseline_undefined"
              ]
            },
            "note": {
              "type": "string"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_price": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gap": {
              "type": [
                "string",
                "null"
              ]
            },
            "rule": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "note",
            "reasons",
            "target_price",
            "gap",
            "rule"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "inputs",
        "breakdown",
        "fixed_cost_per_unit",
        "unit_cost",
        "scenarios",
        "range",
        "yearly",
        "decision"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "consistency",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
