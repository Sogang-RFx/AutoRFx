{
  "$id": "https://autorfx.local/contract/chat-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "history": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "answer": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "question",
          "answer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "question"
  ],
  "additionalProperties": false
}
