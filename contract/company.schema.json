{
  "$id": "https://autorfx.local/contract/company.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "properties": {
            "home_currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "discount_rate": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "min_margin": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "scrap_rate": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "sga_rate": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "max_payment_days": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 365
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_liability": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "home_currency",
            "discount_rate",
            "min_margin",
            "scrap_rate",
            "sga_rate",
            "max_payment_days",
            "max_liability"
          ],
          "additionalProperties": false
        },
        "profile": {
          "type": "object",
          "properties": {
            "certifications": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "processes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "qualifications": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "certifications",
            "processes",
            "qualifications"
          ],
          "additionalProperties": false
        },
        "prices": {
          "maxItems": 300,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^price-[0-9a-f]{12}$"
              },
              "category": {
                "type": "string",
                "enum": [
                  "material",
                  "process",
                  "labor",
                  "purchased",
                  "outsourced",
                  "logistics",
                  "freight",
                  "other",
                  "credit"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "price": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "valid_until": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "department": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "category",
              "name",
              "unit",
              "price",
              "currency",
              "valid_until",
              "department"
            ],
            "additionalProperties": false
          }
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "answer": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ]
              },
              "saved_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "key",
              "label",
              "answer",
              "saved_on"
            ],
            "additionalProperties": false
          }
        },
        "today": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "categories": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "settings",
        "profile",
        "prices",
        "answers",
        "today",
        "categories"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "consistency",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
