{
  "$id": "https://autorfx.local/contract/sentences.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "locus": {
                "type": "object",
                "properties": {
                  "source_doc": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page_number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "section_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "paragraph_index": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "sentence_index": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "source_doc",
                  "page_number",
                  "section_id",
                  "paragraph_index",
                  "sentence_index"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "rects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "locus",
              "text",
              "rects"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "page_number",
        "sentences"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "document",
          "parsing",
          "analysis",
          "citation",
          "translation",
          "source",
          "cost_inputs",
          "precost",
          "chat",
          "evaluation"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "mock",
          "real"
        ]
      }
    }
  },
  "required": [
    "data",
    "provenance"
  ],
  "additionalProperties": false
}
