{
  "$id": "https://autorfx.local/contract/company-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "home_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "discount_rate": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "min_margin": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "scrap_rate": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "sga_rate": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "max_payment_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            },
            {
              "type": "null"
            }
          ]
        },
        "max_liability": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "home_currency",
        "discount_rate",
        "min_margin",
        "scrap_rate",
        "sga_rate",
        "max_payment_days",
        "max_liability"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "certifications",
        "processes",
        "qualifications"
      ],
      "additionalProperties": false
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "material",
              "process",
              "labor",
              "purchased",
              "outsourced",
              "logistics",
              "freight",
              "other",
              "credit"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "price": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "valid_until": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "department": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "name",
          "unit",
          "price",
          "currency",
          "valid_until",
          "department"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "settings",
    "profile",
    "prices"
  ],
  "additionalProperties": false
}
