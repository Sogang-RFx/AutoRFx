# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Raw Client Documents & Media (Keep raw RFQs, specs, and recordings out of Git)
*.doc
*.docx
*.pdf
*.xlsx
*.pptx
*.hwp
*.m4a
*.mp3
data/raw/
!data/.gitkeep
# Exception: the synthetic demo RFQ generated from web/src/fixtures/sample/manuscript.yaml
!web/src/fixtures/sample/*.pdf

# Web
web/node_modules/
web/.next/
web/test-results/
web/playwright-report/
web/public/pdf.worker.min.mjs
*.tsbuildinfo

# SDD documents (kept local; root only, so web/AGENTS.md from Next.js is unaffected)
/AGENTS.md
/REQUIREMENTS.md
/SPEC.md
/TASKS.md
/docs/demo-script.md

# Local AI tool state
.omc/
.serena/

# Vector Stores & Caches
.chroma/
vectorstore/
*.sqlite3
.DS_Store
