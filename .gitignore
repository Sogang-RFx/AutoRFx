# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Raw Client Documents & Media (Keep raw RFQs, specs, and recordings out of Git)
*.doc
*.docx
*.pdf
*.xlsx
*.pptx
*.hwp
*.m4a
*.mp3
data/raw/
!data/.gitkeep
# Pipeline output: stored originals, canonical PDFs, parsed and analysed artifacts, caches
data/work/
data/cache/
# Answer keys may quote RFQ text; kept local until the team decides (OQ-7)
data/answer_keys/
# No exceptions: the GitHub repository is public, so no RFQ file (not even a synthetic one) is committed.

# Web
web/node_modules/
web/.next/
web/test-results/
web/playwright-report/
web/public/pdf.worker.min.mjs
*.tsbuildinfo
# Playwright MCP screenshots and snapshots (may show real RFQ screens)
.playwright-mcp/

# SDD documents (kept local; root only, so web/AGENTS.md from Next.js is unaffected)
/AGENTS.md
/CLAUDE.md
/DESIGN.md
/REQUIREMENTS.md
/SPEC.md
/TASKS.md
/docs/demo-script.md

# Reference material (paid course files, other teams' repos). Never upload.
/docs/references-do-not-upload/

# Local AI tool state
.omc/
.serena/
.remember/

# Test coverage data
.coverage
htmlcov/

# Vector Stores & Caches
.chroma/
vectorstore/
*.sqlite3
.DS_Store

# Test account passwords written by `autorfx users seed`. The repository is public.
/ACCOUNTS.local.md
